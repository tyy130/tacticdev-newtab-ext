{
  "manifest_version": 3,
  "name": "TacticDev New Tab",
  "description": "Replaces the new tab page with a TacticDev browser console.",
  "version": "2.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "notifications"
  ]
}

